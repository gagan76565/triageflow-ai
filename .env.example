# Flask session signing secret (use a long random value in production)
SECRET_KEY=replace-with-a-long-random-secret

# Optional: set a durable database URL for production. Leave unset for local SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Required only for Google Forms/Sheets automatic ingestion.
# Use the exact same secret in Render and Google Apps Script Script Properties.
TRIAGEFLOW_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token
